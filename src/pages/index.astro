---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="wutz.io – Die Schlagzeilen des Tages, kommentiert">
  {
    articles.length === 0 && (
      <p>Noch keine Artikel. Die Redaktion (ein Cronjob) legt bald los.</p>
    )
  }
  {
    articles.map((article) => (
      <article style="margin-bottom: 34px; padding-bottom: 34px; border-bottom: 1px solid var(--border);">
        <h2 style="margin: 0 0 6px; font-size: 26px; line-height: 1.25;">
          <a href={`/artikel/${article.id}/`} style="color: inherit; text-decoration: none;">
            {article.data.title}
          </a>
        </h2>
        <p style="margin: 0 0 8px; color: var(--muted);">{article.data.dek}</p>
        <p style="margin: 0; font-size: 13px; color: var(--muted);">
          {article.data.pubDate.toLocaleDateString("de-DE")} · Quelle:{" "}
          <a href={article.data.sourceUrl} target="_blank" rel="noopener noreferrer">
            {article.data.sourceName}
          </a>
        </p>
      </article>
    ))
  }
</Layout>
