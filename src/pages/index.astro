---
// Full-screen "WUTZ!" animation, migrated from the standalone wutz-fun repo.
// DVD-screensaver-style bouncing logo, posterized plasma background, confetti on click/tap.
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="WUTZ!" />
    <meta name="theme-color" content="#0a0014" />
    <meta name="color-scheme" content="dark" />
    <title>WUTZ!</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style>
      :root { color-scheme: dark; }
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #0a0014;
        cursor: crosshair;
      }
      canvas {
        position: fixed;
        inset: 0;
        z-index: 1;
        display: block;
        image-rendering: pixelated;
        image-rendering: crisp-edges;
      }
      #hint {
        position: fixed;
        left: 50%;
        bottom: 22px;
        transform: translateX(-50%);
        z-index: 2;
        color: #fff;
        font: 600 14px/1.4 monospace;
        opacity: 0.55;
        letter-spacing: 0.04em;
        text-shadow: 0 0 8px rgba(0,0,0,0.6);
        pointer-events: none;
        user-select: none;
      }
      #nav {
        position: fixed;
        top: 14px;
        right: 16px;
        z-index: 2;
        display: flex;
        gap: 14px;
        font: 600 13px/1.4 monospace;
      }
      #nav a {
        color: #fff;
        opacity: 0.55;
        text-decoration: none;
        text-shadow: 0 0 8px rgba(0,0,0,0.6);
      }
      #nav a:hover { opacity: 0.9; }
    </style>
  </head>
  <body>
    <canvas id="stage"></canvas>
    <div id="hint">klick / tipp für konfetti</div>
    <nav id="nav">
      <a href="/antikos-strategy">⚔️ Antikos</a>
      <a href="/impressum">Impressum</a>
    </nav>

    <script is:inline>
      const canvas = document.getElementById("stage");
      const ctx = canvas.getContext("2d", { alpha: false });

      // retro, limited, posterized palette — the "pixel art" constraint
      const PALETTE = [
        "#ff2ec4", "#ff5b3a", "#ffd200", "#00ff9d",
        "#00e0ff", "#7b2ff7", "#ff004d", "#39ff14",
      ];

      const TARGET_COLS = 200; // virtual pixels across the screen — chunkiness knob
      let W, H, PIXEL, bw, bh, imgData, buf;

      function resize() {
        W = window.innerWidth;
        H = window.innerHeight;
        PIXEL = Math.max(3, Math.round(W / TARGET_COLS));
        bw = Math.max(1, Math.round(W / PIXEL));
        bh = Math.max(1, Math.round(H / PIXEL));
        canvas.width = bw;
        canvas.height = bh;
        canvas.style.width = W + "px";
        canvas.style.height = H + "px";
        ctx.imageSmoothingEnabled = false;
        imgData = ctx.createImageData(bw, bh);
        buf = imgData.data;
      }
      window.addEventListener("resize", resize);
      resize();

      function paletteColor(i) {
        return PALETTE[((i % PALETTE.length) + PALETTE.length) % PALETTE.length];
      }
      function hexToRgb(hex) {
        const n = parseInt(hex.slice(1), 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }
      const PALETTE_RGB = PALETTE.map(hexToRgb);

      // ---- chunky posterized plasma background ----
      let t = 0;
      function drawPlasma() {
        const bands = PALETTE_RGB.length;
        let idx = 0;
        for (let y = 0; y < bh; y++) {
          for (let x = 0; x < bw; x++) {
            const v =
              Math.sin(x * 0.14 + t) +
              Math.sin(y * 0.11 - t * 0.8) +
              Math.sin((x + y) * 0.08 + t * 1.3) +
              Math.sin(Math.sqrt((x - bw / 2) ** 2 + (y - bh / 2) ** 2) * 0.16 - t * 1.7);
            const norm = (v + 4) / 8; // 0..1
            const band = Math.floor(norm * bands) % bands;
            const rgb = PALETTE_RGB[band];
            buf[idx++] = rgb[0];
            buf[idx++] = rgb[1];
            buf[idx++] = rgb[2];
            buf[idx++] = 255;
          }
        }
        ctx.putImageData(imgData, 0, 0);
      }

      // ---- bouncing "WUTZ!" logo, DVD-screensaver style, but stepped/snapped to the pixel grid ----
      const TEXT = "WUTZ!";
      let colorIdx = 0;

      function pickFontSize() {
        return Math.max(6, Math.round(bh * 0.22));
      }

      const logo = {
        x: 10,
        y: 10,
        vx: 46, // virtual px / sec
        vy: 34,
        fontSize: pickFontSize(),
      };

      function setFont() {
        ctx.font = `900 ${logo.fontSize}px "Courier New", monospace`;
      }
      setFont();

      function measure() {
        setFont();
        const m = ctx.measureText(TEXT);
        return { w: m.width, h: logo.fontSize };
      }

      function bumpColor() {
        colorIdx = (colorIdx + 1 + ((Math.random() * 3) | 0)) % PALETTE.length;
      }

      // ---- confetti, snapped to the pixel grid ----
      let particles = [];
      function burst(px, py) {
        const x = Math.round(px / PIXEL);
        const y = Math.round(py / PIXEL);
        const n = 26;
        for (let i = 0; i < n; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 12 + Math.random() * 34;
          particles.push({
            x, y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            life: 1,
            decay: 0.6 + Math.random() * 0.7,
            size: 1 + ((Math.random() * 3) | 0),
            colorIdx: (Math.random() * PALETTE.length) | 0,
          });
        }
      }

      function handlePress(clientX, clientY) {
        burst(clientX, clientY);
        bumpColor();
        triggerGlitch();
      }
      window.addEventListener("pointerdown", (e) => handlePress(e.clientX, e.clientY));

      // ---- glitch bursts: scanline tears + channel split, the "verspult" part ----
      let glitchFrames = 0;
      function triggerGlitch() {
        glitchFrames = 4 + ((Math.random() * 6) | 0);
      }
      setInterval(triggerGlitch, 1400 + Math.random() * 1600);

      function applyGlitch() {
        if (glitchFrames <= 0) return;
        glitchFrames--;

        const frame = ctx.getImageData(0, 0, bw, bh);
        const src = frame.data;
        const out = new Uint8ClampedArray(src);

        // a few random horizontal tears, shifted left/right and wrapped
        const tears = 2 + ((Math.random() * 3) | 0);
        for (let i = 0; i < tears; i++) {
          const bandY = (Math.random() * bh) | 0;
          const bandH = 1 + ((Math.random() * (bh * 0.06)) | 0);
          const shift = ((Math.random() * bw * 0.3) | 0) * (Math.random() < 0.5 ? -1 : 1);
          for (let y = bandY; y < Math.min(bh, bandY + bandH); y++) {
            for (let x = 0; x < bw; x++) {
              const sx = ((x - shift) % bw + bw) % bw;
              const si = (y * bw + sx) * 4;
              const di = (y * bw + x) * 4;
              out[di] = src[si];
              out[di + 1] = src[si + 1];
              out[di + 2] = src[si + 2];
              out[di + 3] = 255;
            }
          }
        }

        // RGB channel split across the whole frame
        const csplit = 1 + ((Math.random() * 2) | 0);
        for (let y = 0; y < bh; y++) {
          for (let x = 0; x < bw; x++) {
            const di = (y * bw + x) * 4;
            const rx = Math.min(bw - 1, x + csplit);
            const bx = Math.max(0, x - csplit);
            out[di] = src[(y * bw + rx) * 4];
            out[di + 2] = src[(y * bw + bx) * 4 + 2];
          }
        }

        frame.data.set(out);
        ctx.putImageData(frame, 0, 0);
      }

      // ---- animation loop ----
      let last = performance.now();

      function step(now) {
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;
        t += dt * 1.6;

        // move logo in the virtual (buffer) pixel grid, then snap to whole pixels — stepped, not smooth
        logo.x += logo.vx * dt;
        logo.y += logo.vy * dt;

        const { w, h } = measure();
        let bounced = false;

        if (logo.x <= 0) { logo.x = 0; logo.vx *= -1; bounced = true; }
        if (logo.x + w >= bw) { logo.x = bw - w; logo.vx *= -1; bounced = true; }
        if (logo.y - h <= 0) { logo.y = h; logo.vy *= -1; bounced = true; }
        if (logo.y >= bh) { logo.y = bh; logo.vy *= -1; bounced = true; }

        if (bounced) {
          bumpColor();
          triggerGlitch();
          burst((logo.x + w / 2) * PIXEL, (logo.y - h / 2) * PIXEL);
        }

        drawPlasma();

        // particles
        particles.forEach((p) => {
          p.life -= p.decay * dt;
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          p.vy += 30 * dt;
        });
        particles = particles.filter((p) => p.life > 0);
        particles.forEach((p) => {
          ctx.fillStyle = paletteColor(p.colorIdx);
          ctx.fillRect(Math.round(p.x), Math.round(p.y), p.size, p.size);
        });

        // hard-edged pixel-art text: flat offset shadow, no blur, snapped to the grid
        const sx = Math.round(logo.x + w / 2);
        const sy = Math.round(logo.y - h / 2);
        setFont();
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillStyle = "#000";
        ctx.fillText(TEXT, sx + 2, sy + 2);
        ctx.fillStyle = paletteColor(colorIdx);
        ctx.fillText(TEXT, sx, sy);
        ctx.fillStyle = "#fff";
        ctx.fillText(TEXT, sx, sy - 1);

        applyGlitch();

        requestAnimationFrame(step);
      }

      requestAnimationFrame(step);

      // occasional ambient confetti so it stays alive even without clicks
      setInterval(() => {
        burst(Math.random() * W, Math.random() * H * 0.4);
      }, 3500);
    </script>
  </body>
</html>
