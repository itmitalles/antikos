---
const base = import.meta.env.BASE_URL;
const to = (path = "") => `${base}/${path}`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Antikos — rundenbasiertes Zivilisationsspiel auf großer Hexwelt." />
    <meta name="theme-color" content="#17181c" />
    <title>Antikos</title>
    <link rel="icon" type="image/svg+xml" href={to("favicon.svg")} />
    <style>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: radial-gradient(circle at 50% 0%, #344b57, #17181c 55%); color: #eceef2; font: 16px/1.55 system-ui, sans-serif; }
      main { width: min(680px, calc(100% - 32px)); padding: 44px; border: 1px solid #4b6170; border-radius: 16px; background: #1f292fdd; box-shadow: 0 24px 60px #0008; }
      h1 { margin: 0; font-size: clamp(42px, 9vw, 76px); letter-spacing: -0.06em; }
      h1 span, a { color: #ffe066; }
      p { max-width: 58ch; color: #c4ced4; font-size: 18px; }
      .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
      .play { display: inline-block; padding: 12px 20px; border-radius: 8px; background: #ffe066; color: #201a00; font-weight: 800; text-decoration: none; }
      .legal { padding: 12px 4px; color: #d8dde0; }
    </style>
  </head>
  <body>
    <main>
      <h1>Antik<span>os</span></h1>
      <p>Eine wachsende Zivilisation auf großer Hexwelt: Städte, Siedlungen, Straßen, Flüsse und Ressourcen — rundenbasiert und lokal spielbar.</p>
      <div class="actions">
        <a class="play" href={to("antikos-strategy/")}>⚔️ Spiel starten</a>
        <a class="legal" href={to("impressum/")}>Impressum</a>
      </div>
    </main>
  </body>
</html>
