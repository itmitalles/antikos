---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Antikos — rundenbasiertes Zivilisationsspiel</title>
    <meta name="description" content="Antikos: rundenbasiertes Zivilisationsspiel mit großer Hexwelt, Städten, Straßen, Flüssen und sichtbaren Ressourcen." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚔️</text></svg>" />
    <style>
      :root {
        --bg: #17181c;
        --panel: #1f2127;
        --panel-2: #23252c;
        --ink: #eceef2;
        --muted: #9aa0ac;
        --accent: #ffe066;
        --border: #33363f;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--ink);
        font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      a { color: var(--accent); }
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 18px;
        border-bottom: 1px solid var(--border);
      }
      .topbar .brand { font-weight: 700; letter-spacing: -0.5px; text-decoration: none; color: var(--ink); }
      .topbar .brand span { color: var(--accent); }
      .hidden { display: none !important; }

      #setup-screen {
        max-width: 520px;
        margin: 40px auto;
        padding: 24px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 10px;
      }
      #setup-screen h1 { margin-top: 0; font-size: 22px; }
      #setup-screen p { color: var(--muted); }
      #setup-screen label { display: block; margin: 14px 0 6px; color: var(--muted); font-size: 13px; }
      #setup-screen select { padding: 6px 8px; background: var(--panel-2); color: var(--ink); border: 1px solid var(--border); border-radius: 6px; }
      .player-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 8px 0;
      }
      .player-row .swatch, .player-chip .swatch {
        width: 14px; height: 14px; border-radius: 50%;
        background: var(--pcolor);
        flex-shrink: 0;
        display: inline-block;
      }
      .player-row input[type="text"] {
        flex: 1;
        padding: 6px 8px;
        background: var(--panel-2);
        color: var(--ink);
        border: 1px solid var(--border);
        border-radius: 6px;
      }
      .player-row select {
        padding: 6px 8px;
        background: var(--panel-2);
        color: var(--ink);
        border: 1px solid var(--border);
        border-radius: 6px;
      }
      button {
        cursor: pointer;
        font: inherit;
        padding: 9px 16px;
        border-radius: 7px;
        border: 1px solid var(--border);
        background: var(--panel-2);
        color: var(--ink);
      }
      button:hover:not(:disabled) { border-color: var(--accent); }
      button:disabled { opacity: 0.4; cursor: not-allowed; }
      #start-button, #restart-button {
        background: var(--accent);
        color: #201a00;
        border: none;
        font-weight: 700;
        margin-top: 18px;
      }

      #game-screen {
        display: flex;
        gap: 16px;
        padding: 16px;
        max-width: 1180px;
        margin: 0 auto;
        align-items: flex-start;
        flex-wrap: wrap;
      }
      #board-wrap {
        background: linear-gradient(180deg, #202a32 0%, #11171d 100%);
        border: 1px solid #3c4b57;
        border-radius: 10px;
        padding: 38px 28px 46px;
        flex: 1 1 520px;
        min-width: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        overflow: hidden;
        box-shadow: inset 0 -34px 0 rgba(0,0,0,0.2), 0 16px 35px rgba(0,0,0,0.3);
      }
      #board-canvas {
        max-width: 100%;
        height: auto;
        display: block;
        image-rendering: auto;
        /* The terrain and buildings provide the isometric depth. Keep the canvas flat
           so panning, zooming and hex hit-testing use the same coordinate plane. */
        transform: scale(1.08);
        transform-origin: 50% 50%;
        filter: saturate(1.12) contrast(1.05);
        box-shadow: 0 22px 22px rgba(0,0,0,0.48);
      }
      #board-controls {
        position: absolute;
        right: 12px;
        bottom: 12px;
        display: flex;
        gap: 5px;
        z-index: 2;
      }
      #board-controls button { padding: 4px 10px; background: #26343d; border-color: #4d626e; }

      #sidebar {
        flex: 0 0 320px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px 14px;
      }
      .panel h2 {
        margin: 0 0 8px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
      }
      #turn-info { font-size: 17px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
      #turn-info .dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
      #action-hint { margin-top: 8px; color: var(--muted); font-size: 13px; }
      #tile-info { margin-top: 6px; font-size: 13px; color: var(--ink); min-height: 1.2em; }
      .actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
      .build-select { width: 100%; padding: 8px; background: var(--panel-2); color: var(--ink); border: 1px solid var(--border); border-radius: 6px; }
      .preview-note { color: var(--muted); font-size: 12px; margin: 8px 0 0; }

      #resource-panel { display: flex; gap: 12px; flex-wrap: wrap; font-size: 16px; }
      #resource-panel .res { background: var(--panel-2); border-radius: 6px; padding: 4px 8px; }

      .player-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 5px 0;
        font-size: 13px;
      }
      .player-chip.dead { opacity: 0.4; text-decoration: line-through; }

      #log-panel {
        max-height: 220px;
        overflow-y: auto;
        font-size: 12.5px;
        color: var(--muted);
        display: flex;
        flex-direction: column;
        gap: 3px;
      }

      #gameover-banner {
        position: fixed;
        inset: 0;
        background: #000000cc;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
      }
      #gameover-banner .box {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 30px 40px;
        text-align: center;
      }
      #gameover-banner h2 { margin: 0 0 6px; font-size: 26px; }
    </style>
  </head>
  <body>
    <div class="topbar">
      <a class="brand" href={`${base}/`}>Antik<span>os</span></a>
      <a href={`${base}/`}>← zur Startseite</a>
    </div>

    <div id="setup-screen">
      <h1>⚔️ Antikos</h1>
      <p>Baue eine wachsende Zivilisation auf einer großen Hexwelt: Hauptstadt, Siedlungen, Straßen, Flüsse und sichtbare Ressourcen. 2–4 Spieler, lokal (Hotseat) oder gegen KI.</p>
      <label for="player-count">Spieleranzahl</label>
      <select id="player-count">
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4" selected>4</option>
      </select>
      <div id="player-rows"></div>
      <button id="start-button">Spiel starten</button>
    </div>

    <div id="game-screen" class="hidden">
      <div id="board-wrap">
        <canvas id="board-canvas"></canvas>
        <div id="board-controls" aria-label="Kartenkamera">
          <button id="camera-zoom-out" type="button" title="Herauszoomen">−</button>
          <button id="camera-reset" type="button" title="Karte zentrieren">⌂</button>
          <button id="camera-zoom-in" type="button" title="Hineinzoomen">+</button>
        </div>
      </div>
      <div id="sidebar">
        <div class="panel">
          <div id="turn-info"></div>
          <div id="action-hint"></div>
          <div id="tile-info"></div>
          <div class="actions">
            <button id="action-found-settlement" class="hidden">Siedlung gründen</button>
            <button id="action-road-plan" class="hidden">Straße planen</button>
            <button id="action-road-confirm" class="hidden">Straßenauftrag bestätigen</button>
            <button id="action-road-cancel" class="hidden">Plan verwerfen</button>
            <select id="city-building-select" class="build-select hidden">
              <option value="housing">Wohnviertel</option>
              <option value="production">Produktionshof</option>
              <option value="storage">Lager / Markt</option>
              <option value="military">Militärgebäude</option>
              <option value="culture">Kultur- / Sakralbau</option>
            </select>
            <button id="action-city-building" class="hidden">Gebäude errichten</button>
            <button id="action-recruit-militia" class="hidden">Miliz ausheben</button>
            <button id="action-recruit-legionary" class="hidden">Legionäre ausheben</button>
            <button id="action-recruit-cavalry" class="hidden">Reiterei ausheben</button>
            <button id="action-upgrade" class="hidden">Ausbauen</button>
            <button id="action-fort" class="hidden">Burg bauen</button>
            <button id="action-end-build" class="hidden">Weiter zum Angriff</button>
            <button id="action-end-turn" class="hidden">Zug beenden</button>
          </div>
          <p class="preview-note">Kartenerzeugung, Ressourcenverteilung, Erträge, Gebäudeboni und Handelsregeln sind im Vertical Slice vorläufig.</p>
        </div>
        <div class="panel">
          <h2>Rohstoffe</h2>
          <div id="resource-panel"></div>
        </div>
        <div class="panel">
          <h2>Spieler</h2>
          <div id="players-panel"></div>
        </div>
        <div class="panel">
          <h2>Verlauf</h2>
          <div id="log-panel"></div>
        </div>
      </div>
    </div>

    <div id="gameover-banner" class="hidden">
      <div class="box">
        <h2>🏆 <span id="winner-name"></span> gewinnt!</h2>
        <button id="restart-button">Neues Spiel</button>
      </div>
    </div>

    <script>
      import "../../play/main.ts";
    </script>
  </body>
</html>
