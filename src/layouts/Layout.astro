---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Antikos — rundenbasiertes Zivilisationsspiel." } = Astro.props;
const base = import.meta.env.BASE_URL;
const to = (path = "") => `${base}/${path}`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={to("favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={to("favicon-32.png")} />
    <link rel="apple-touch-icon" href={to("apple-touch-icon.png")} />
    <style>
      :root {
        --ink: #17171a;
        --muted: #6b6b74;
        --bg: #fafaf8;
        --card: #fff;
        --accent: #d81e3f;
        --border: #e8e6e1;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #eeeeee;
          --muted: #9a9aa2;
          --bg: #121214;
          --card: #1a1a1d;
          --accent: #ff4d6a;
          --border: #2a2a2e;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 17px/1.6 Georgia, "Times New Roman", serif;
      }
      header {
        border-bottom: 3px solid var(--ink);
        padding: 22px 20px 14px;
        text-align: center;
      }
      header a { text-decoration: none; color: inherit; }
      .brand {
        font-family: "Impact", "Arial Black", sans-serif;
        font-size: 40px;
        letter-spacing: -1px;
        text-transform: uppercase;
      }
      .brand span { color: var(--accent); }
      .tagline {
        color: var(--muted);
        font-size: 14px;
        font-style: italic;
        margin-top: 4px;
      }
      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 30px 20px 60px;
      }
      footer {
        max-width: 760px;
        margin: 0 auto;
        padding: 20px;
        color: var(--muted);
        font-size: 13px;
        text-align: center;
        border-top: 1px solid var(--border);
      }
      a { color: var(--accent); }
    </style>
  </head>
  <body>
    <header>
      <a href={to()}><div class="brand">Antik<span>os</span></div></a>
      <div class="tagline">Rundenbasiertes Zivilisationsspiel auf großer Hexwelt.</div>
      <div class="tagline"><a href={to("antikos-strategy/")}>⚔️ Antikos spielen</a></div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      Antikos Vertical Slice. &middot; <a href={to("impressum/")}>Impressum</a>
    </footer>
  </body>
</html>
